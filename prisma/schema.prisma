// Database schema for the handloom store.
// Uses plain String fields for statuses/lists to keep the schema simple.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String?        @unique
  phone        String?        @unique
  passwordHash String?
  googleId     String?        @unique
  role         String         @default("CUSTOMER") // CUSTOMER | ADMIN
  createdAt    DateTime       @default(now())
  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  wishlist     WishlistItem[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}

model Category {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  description    String?
  image          String?
  bannerImage    String?
  bannerTitle    String?
  bannerSubtitle String?
  bannerColor    String?
  showInMenu     Boolean    @default(true)
  sortOrder      Int        @default(0)
  parentId       String?
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[] @relation("CategoryTree")
  products       Product[]
  createdAt      DateTime   @default(now())
}

model Product {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String         @default("")
  price       Int // selling price in rupees
  mrp         Int // maximum retail price in rupees
  stock       Int            @default(0)
  sku         String?
  fabric      String?
  weave       String?
  origin      String?
  care        String?
  dimensions  String?
  sizes       String         @default("") // comma separated, e.g. "S,M,L"
  colors      String         @default("") // comma separated, e.g. "Red,Indigo"
  badge       String? // e.g. "New Arrival", "Fast Moving", "Bestseller"
  featured    Boolean        @default(false)
  isActive    Boolean        @default(true)
  soldCount   Int            @default(0)
  categoryId  String?
  category    Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  reviews     Review[]
  wishlistBy  WishlistItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  @@unique([productId, userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  status            String      @default("PENDING") // PENDING | CONFIRMED | SHIPPED | DELIVERED | CANCELLED
  paymentMethod     String // COD | ONLINE
  paymentStatus     String      @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?
  subtotal          Int
  discount          Int         @default(0)
  shipping          Int         @default(0)
  total             Int
  couponCode        String?
  shipName          String
  shipPhone         String
  shipLine1         String
  shipLine2         String?
  shipCity          String
  shipState         String
  shipPincode       String
  courier           String?
  trackingNumber    String?
  trackingUrl       String?
  notes             String?
  items             OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  name      String
  image     String?
  price     Int
  quantity  Int
  size      String?
  color     String?
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  type        String // PERCENT | FLAT
  value       Int
  minOrder    Int      @default(0)
  maxDiscount Int?
  active      Boolean  @default(true)
  showOnSite  Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Banner {
  id        String  @id @default(cuid())
  title     String
  subtitle  String?
  image     String?
  bgColor   String?
  link      String?
  cta       String?
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

model Announcement {
  id        String  @id @default(cuid())
  text      String
  link      String?
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

model Setting {
  key   String @id
  value String
}
