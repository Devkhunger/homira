# ---- Database ----
# PostgreSQL connection string. On Railway use ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/homira"

# ---- Site ----
SITE_URL=""   # optional; on Railway the domain is detected automatically
# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# ---- First owner/admin account (used by `npm run setup` / `npm run create-admin`) ----
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="ChangeMe@123"
ADMIN_NAME="Store Owner"

# ---- Image uploads ----
# Folder where product/banner images are stored on the server.
UPLOAD_DIR="./uploads"

# ---- Razorpay (online payments: UPI, cards, netbanking, wallets) ----
# Get keys from https://dashboard.razorpay.com/app/keys . Leave blank to allow only Cash on Delivery.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ---- Google login ----
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: {SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Phone OTP via SMS (MSG91) ----
# If left blank, OTPs are printed to the server console (development only).
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
